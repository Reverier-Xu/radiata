# Multi-stage build for the radiata chat demo node.
# Build from the repository root:
#   podman build -t radiata-chat-node -f examples/chat/Containerfile .
FROM rust:1.98-bookworm AS build
WORKDIR /build
COPY . /build
WORKDIR /build/examples/chat
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/examples/chat/target/release/radiata-chat-node /usr/local/bin/node
ENV LISTEN=wss://127.0.0.1:9443
ENV HTTP_LISTEN=0.0.0.0:8080
ENV DATA=/data
ENV CHAT_USER=anonymous
VOLUME /data
EXPOSE 9443 8080
ENTRYPOINT ["/usr/local/bin/node"]
