# Multi-stage build for the radiata cluster demo node.
# Build from the repository root:
#   podman build -t radiata-cluster-node -f examples/cluster/Containerfile .
FROM rust:1.98-bookworm AS build
WORKDIR /build
COPY . /build
WORKDIR /build/examples/cluster
# CARGO_FEATURES is passed through to cargo's --features (the SLO
# harness builds with CARGO_FEATURES=audit so the container logs carry
# the semantic path events it asserts on).
ARG CARGO_FEATURES=""
RUN cargo build --release --features "$CARGO_FEATURES"

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/examples/cluster/target/release/radiata-cluster-node /usr/local/bin/node
ENV LISTEN=wss://127.0.0.1:9443
ENV HTTP_LISTEN=0.0.0.0:8080
ENV DATA=/data
VOLUME /data
EXPOSE 9443 8080
ENTRYPOINT ["/usr/local/bin/node"]
